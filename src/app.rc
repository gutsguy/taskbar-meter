#include <windows.h>

1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,1,0,0
 PRODUCTVERSION  1,1,0,0
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "TaskbarMeter"
      VALUE "FileDescription",  "TaskbarMeter - tiny taskbar system monitor"
      VALUE "FileVersion",      "1.1.0"
      VALUE "InternalName",     "TaskbarMeter"
      VALUE "LegalCopyright",   "MIT License"
      VALUE "OriginalFilename", "TaskbarMeter.exe"
      VALUE "ProductName",      "TaskbarMeter"
      VALUE "ProductVersion",   "1.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
